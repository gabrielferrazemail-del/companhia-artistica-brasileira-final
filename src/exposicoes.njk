---
layout: base.njk
title: "Exposições"
---
<section class="page-section">
  <header class="page-header">
    <h1 class="page-title">Exposições</h1>
    <p class="page-sub">Mostras do coletivo — em cartaz, em breve e anteriores.</p>
  </header>

  <div class="expo-grid">
    {% for expo in collections.exposicoes %}
      {% if expo.data.effectiveStatus == "em-cartaz" or expo.data.effectiveStatus == "em-breve" %}
        {% include "partials/exhibition-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>

  {% set temEncerradas = false %}
  {% for expo in collections.exposicoes %}
    {% if expo.data.effectiveStatus == "encerrada" %}{% set temEncerradas = true %}{% endif %}
  {% endfor %}

  {% if temEncerradas %}
  <h2 class="section-title" style="margin-top:48px">Anteriores</h2>
  <div class="expo-grid">
    {% for expo in collections.exposicoes %}
      {% if expo.data.effectiveStatus == "encerrada" %}
        {% include "partials/exhibition-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
  {% endif %}
</section>
