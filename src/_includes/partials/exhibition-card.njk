<article class="expo-card">
  <a href="/exposicoes/{{ expo.data.slug }}/" class="expo-card-link">
    <div class="expo-card-img">
      {% if expo.data.cover %}
        <img src="{{ expo.data.cover }}" alt="{{ expo.data.title }}" loading="lazy">
      {% else %}
        <div class="expo-card-placeholder" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="1"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="m21 15-5-5L5 21"/>
          </svg>
        </div>
      {% endif %}
    </div>
    <div class="expo-card-info">
      <p class="expo-card-year">
        {% if expo.data.effectiveStatus %}<span class="expo-card-status status-{{ expo.data.effectiveStatus }}">{{ expo.data.effectiveStatus | statusLabel }}</span>{% endif %}
        {% if expo.data.start_date %}{{ expo.data.start_date | formatDate }}{% endif %}
      </p>
      <h3 class="expo-card-title">{{ expo.data.title }}</h3>
      {% if expo.data.summary %}<p class="expo-card-summary">{{ expo.data.summary }}</p>{% endif %}
    </div>
  </a>
</article>
