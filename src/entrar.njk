---
layout: base.njk
title: "Entrar"
---
<section class="auth-page">
  <div class="auth-card">
    <p class="kicker">Acesso</p>
    <h1 class="auth-title">Entrar</h1>

    <!-- Estado: deslogado -->
    <div data-when-loggedout>
      <p class="auth-text">
        Artistas: personalize o seu perfil. Administração: gerencie as exposições.
      </p>
      <button class="btn-primary" type="button" data-login>Entrar / Criar acesso</button>
    </div>

    <!-- Estado: logado (transição/redirect ou fallback sem papel) -->
    <div data-when-loggedin hidden>
      <p class="auth-text" id="entrar-status">Entrando…</p>
      <div class="auth-actions">
        <a class="btn-primary" href="/painel/" data-only-admin hidden>Ir para o painel</a>
        <a class="btn-primary" href="/minha-conta/" data-only-artist hidden>Ir para meu perfil</a>
        <button class="btn-ghost" type="button" data-logout>Sair</button>
      </div>
    </div>

    <p class="auth-note">O acesso é por convite. Em caso de dúvida, fale com a administração do coletivo.</p>
  </div>
</section>
